\version "2.25.22"

\markup \combine
  \with-color \grey \filled-box #'(-1 . 70) #'(-2  . 7) #0
  \fontsize #10 \line {
    \whiteout foo
    \whiteout \pad-markup #0.5 foo
    \override #'(thickness . 3) \whiteout foo
