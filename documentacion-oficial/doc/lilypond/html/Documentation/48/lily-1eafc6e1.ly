\version "2.24.0"

\header {
%% Translation of GIT committish: c043783aac6c35926d633aa2daf60ed4f2e7ca7a
  texidocfr = "
En basse chiffrée, des glyphes spécifiques sont utilisés par défaut pour
les @code{6\\\\}, @code{7\\\\} et @code{9\\\\}. D'autres glyphes ont été
conçus pour les @code{2\\+}, @code{4\\+} et @code{5\\+} ; ils sont
utilisés par défaut dès lors qu'un signe plus est ajouté au chiffre.

Pour modifier ce comportement, il faut passer une liste associative à
@code{figuredBassPlusStrokedAlist} et basculer le glyphe en question
sur @code{#f} (ou ne pas le mentionner).
"

  doctitlefr = "Ajustement des glyphes d'altération en basse chifrée"

%% Translation of GIT committish: 70abecb938c2bb752967bd56b7402dd8129838a5
  texidoces = "
De forma predeterminada, en el bajo cifrado se usan glifos
diseñados espcialmente para @code{6\\\\}, @code{7\\\\} y
@code{9\\\\}.  De forma similar, se usan de forma predeterminada
glifos diseñados especialmente para los símbolos @code{2\\+},
@code{4\\+} y @code{5\\+}, si aparece un signo más después del
número.

Para cambiarlo, pase una lista-A a
@code{figuredBassPlusStrokedAlist} y establezca el glifo en
cuestión a @code{#f} o no lo especifique en absoluto.
"

  doctitlees = "Ajustar los glifos de las alteraciones en el bajo cifrado"

  categories = "Chords"

  texidoc = "
In figured bass, specially designed glyphs for @code{6\\\\},
@code{7\\\\}, and @code{9\\\\} are used by default. Similarly,
specially designed glyphs for symbols @code{2\\+}, @code{4\\+}, and
@code{5\\+} are used by default if plus signs appear after the number.

To change that, pass an alist to @code{figuredBassPlusStrokedAlist} and
set the glyph in question to @code{#f} (or omit it).
"

  doctitle = "Adjusting figured bass alteration glyphs"
} % begin verbatim


#(set-global-staff-size 26)

\figures {
  \set figuredBassPlusDirection = #RIGHT
  <6\\> <7\\> <9\\> r
  <2\+> <4\+> <5\+> r

  \set figuredBassPlusStrokedAlist =
    #'((2 . "figbass.twoplus")
       ;; (4 . "figbass.fourplus")
       ;; (5 . "figbass.fiveplus")
       (6 . "figbass.sixstroked")
       ;; (7 . "figbass.sevenstroked")
       ;; (9 . "figbass.ninestroked")
      )
  <6\\> <7\\> <9\\> r
  <2\+> <4\+> <5\+> r
}



