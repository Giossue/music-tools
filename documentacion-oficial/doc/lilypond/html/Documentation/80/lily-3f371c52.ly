\new Staff \relative c''{
  \override Glissando.breakable = ##t
  
  %% gliss non gliss and 
  c4 \glissando d e \glissando f \glissando \break
  %% consecutive 
  c \glissando d, \glissando e'
  << { e8 \glissando g8 } \\
     { \repeat unfold 4 d16 } >>
  \override Glissando.style = #'zigzag
  c4 \glissando c,, \glissando c' \glissando d
}





