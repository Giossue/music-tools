tabstuff = {
  \time 3/4
  \compressMMRests {
    c4^"test" d( e) |
    f4\f g a^\fermata |
    R2.*3 |
    c8\<\( c16 c ~ 2\! |
    \mark \default
    c'2.\) |
    \ottava #1
    r4 d'4 r8 e |
    \ottava #0
    \tuplet 4/3 { b,4 c \glissando d\5 \glissando c } |
    c4. d-_( |
    e\varcoda-> )
    \override TextSpanner.bound-details.left.text = "rit." f\startTextSpan |
    g ~ g\prall |
    g\thumb e-.\stopTextSpan
    \bar "|."
  }
}

#(set-global-staff-size 18)

