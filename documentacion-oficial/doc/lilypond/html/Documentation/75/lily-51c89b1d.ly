  doctitlefr = "Stylisation des lignes de soufflet"

%% Translation of GIT committish: 1bf2403e1cd7038a1e7ea62da560af601e3694fc
  texidoces = "
Los reguladores pueden imprimirse en uno cualquiera de los estilos
de @code{line-interface}: @code{dashed-line} (discontinuo),
@code{dotted-line} (punteado), @code{line} (línea continua),
@code{trill} (trino) o @code{zigzag} (zig-zag).

"
  doctitlees = "Reguladores con distintos estilos de línea"

%% Translation of GIT committish: 8ffecf6be17c6ec2ff87cf31873121a8cce29b09
