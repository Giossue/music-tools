  \set fretLabels = \markuplist {\with-color #red "a"
                       "b"
                       \italic \smaller "c"}
  <f d>4. <bes>8 <g e>4
  \set fretLabels = \markuplist {"α" "β" "γ"}
  <f d>4. <bes>8 <g e>4
}

\score {
