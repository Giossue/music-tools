\new Voice \fixed c' {
  \repeat unfold 2 {
    \repeat volta 3 {
      <<
        \volta 1,2 d1
        \volta 3 f
      >>
    } \alternative {
      <<
        \volta 1 f1
        \volta 2 a
      >>
      <d a>
    }
  }
}



