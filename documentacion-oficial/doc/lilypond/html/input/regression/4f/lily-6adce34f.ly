  <\tweak #'style #'triangle c' c''>
  <c' \tweak #'style #'triangle c''>
  <\tweak #'style #'triangle f' f''>
  <f' \tweak #'style #'triangle f''>

  \break

  <\tweak #'style #'petrucci c' c''>
  <c' \tweak #'style #'petrucci c''>
  <\tweak #'style #'petrucci f' f''>
  <f' \tweak #'style #'petrucci f''>
