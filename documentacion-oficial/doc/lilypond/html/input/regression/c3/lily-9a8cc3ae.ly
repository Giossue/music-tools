  \override TextScript.staff-padding = #3
  \motif #'default
  \motif #'standard
  \motif #'reversed
  \motif #'below
  \motif #'circleheels }


\markup { Without \typewriter Toe_heel_engraver }
\markup \vspace #0.5
\new Voice \with {
  \remove Toe_heel_engraver
} \music

\markup { With \typewriter Toe_heel_engraver }
\markup \vspace #0.5
\new Voice \music



